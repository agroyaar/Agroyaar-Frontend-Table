{
  "name": "@npmagroyaar/table",
  "version": "1.0.2-3",
  "description": "Agroyaar Table",
  "main": "dist/index.js",
  "type": "module",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "release": "release-it",
    "test": "echo \"No tests specified\" && exit 0",
    "type-check": "tsc --noEmit",
    "spell-check": "cspell -- src/**/*.{ts,tsx,md}",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "check-all": "pnpm run spell-check && pnpm run type-check && pnpm run lint && pnpm run build"
  },
  "publishConfig": {
    "access": "public"
  },
  "release-it": {
    "git": {
      "tagName": "v${version}"
    },
    "npm": {
      "publish": true
    },
    "hooks": {
      "before:init": [
        "pnpm build"
      ]
    },
    "github": {
      "release": true
    }
  },
  "keywords": [
    "form",
    "generator",
    "typescript",
    "react-hook-form"
  ],
  "author": "agroyaar team",
  "license": "MIT",
  "packageManager": "pnpm@10.12.1",
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@swc/core": "^1.12.1",
    "@types/react": "^19.1.8",
    "@typescript-eslint/eslint-plugin": "^8.34.0",
    "@typescript-eslint/parser": "^8.34.0",
    "autoprefixer": "^10.4.21",
    "cspell": "^9.1.1",
    "eslint": "^9.29.0",
    "react": "^19.1.0",
    "release-it": "^19.0.5",
    "tsup": "^8.5.0",
    "typescript": "^5.8.3"
  },
  "peerDependencies": {
    "react": "^19.1.0"
  }
}
